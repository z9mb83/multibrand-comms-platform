# Copy to .env for local development. Never commit real values.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/comms
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
INTERNAL_TOKEN=replace-with-a-random-token
# PROVIDER_MODE: mock | live
PROVIDER_MODE=mock
# TASK_BACKEND: inline | cloud_tasks
TASK_BACKEND=inline
CORS_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91
WHATSAPP_VERIFY_TOKEN=replace-me
# WHATSAPP_APP_SECRET_REF=gsm:projects/PROJECT/secrets/whatsapp-app-secret/versions/latest

# Cloud (production only)
# GCP_PROJECT=your-project
# GCP_REGION=asia-south1
# CLOUD_TASKS_QUEUE=outbound
# INTERNAL_BASE_URL=https://api-xxxx.a.run.app
# INTERNAL_OIDC_AUDIENCE=https://api-xxxx.a.run.app

# Frontend (frontend/): where Next.js proxies /api/* to
# API_URL=http://localhost:8000

# --- Sign-in options (leave commented out until configured) ---
# Public URL of the dashboard; Google redirects to <PUBLIC_APP_URL>/api/auth/google/callback
# PUBLIC_APP_URL=https://your-dashboard.example.com
# Sign in with Google (OAuth client of type "Web application" in Google Cloud Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email for sign-in codes: MAILER=smtp (any SMTP, e.g. Gmail/Workspace app password) or MAILER=resend
# MAILER=smtp
# MAIL_FROM=Comms Hub <no-reply@yourdomain.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# RESEND_API_KEY=
